    {
      "name": "Consulta d'A Menina que Roubava Livros",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status HTTP deve ser 200\", function () {\n    pm.response.to.have.status(200);\n});\n\npm.test(\"O livro tem de ser A Menina que Roubava Livros\", function () {\n    const response = pm.response.json();\n    const book = response.book || response;\n\n    pm.expect(book.title).to.eql(\"A Menina que Roubava Livros\");\n});\n\npm.test(\"O autor tem de ser Markus Zusak\", function () {\n    const response = pm.response.json();\n    const book = response.book || response;\n\n    pm.expect(book.author).to.eql(\"Markus Zusak\");\n});\n\npm.test(\"O ID tem de ser 8\", function () {\n    const response = pm.response.json();\n    const book = response.book || response;\n\n    pm.expect(book.id).to.eql(8);\n});"
            ]
          }
        }
      ],
